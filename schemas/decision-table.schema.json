{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Decision Table Toolkit 1.0",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "title": {
      "type": "string",
      "maxLength": 256
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "maxLength": 1024
          },
          "type": {
            "enum": [
              "boolean",
              "enum",
              "number",
              "string",
              "date"
            ]
          },
          "partitions": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 1024
                    },
                    "kind": {
                      "const": "values"
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "oneOf": [
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "string",
                            "maxLength": 1024
                          }
                        ]
                      },
                      "minItems": 1,
                      "maxItems": 10000
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "kind",
                    "values"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 1024
                    },
                    "kind": {
                      "const": "range"
                    },
                    "range": {
                      "type": "object",
                      "properties": {
                        "lower": {
                          "oneOf": [
                            {
                              "type": "string",
                              "maxLength": 128
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "upper": {
                          "oneOf": [
                            {
                              "type": "string",
                              "maxLength": 128
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "lowerInclusive": {
                          "type": "boolean"
                        },
                        "upperInclusive": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "lower",
                        "upper",
                        "lowerInclusive",
                        "upperInclusive"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "kind",
                    "range"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 1024
                    },
                    "kind": {
                      "const": "missing"
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "kind"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "minItems": 1,
            "maxItems": 10000
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "partitions"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "outputs": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "name": {
                "type": "string",
                "maxLength": 1024
              },
              "kind": {
                "const": "action"
              }
            },
            "required": [
              "id",
              "name",
              "kind"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "name": {
                "type": "string",
                "maxLength": 1024
              },
              "kind": {
                "const": "result"
              },
              "type": {
                "enum": [
                  "boolean",
                  "number",
                  "string",
                  "date"
                ]
              }
            },
            "required": [
              "id",
              "name",
              "kind",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "name": {
                "type": "string",
                "maxLength": 1024
              },
              "kind": {
                "const": "result"
              },
              "type": {
                "const": "enum"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 1024
                },
                "minItems": 1,
                "maxItems": 10000
              }
            },
            "required": [
              "id",
              "name",
              "kind",
              "type",
              "values"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "anyOf": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "selections": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "conditionId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "partitionIds": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "minItems": 1,
                        "maxItems": 10000
                      }
                    },
                    "required": [
                      "conditionId",
                      "partitionIds"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1,
                  "maxItems": 10000
                }
              },
              "required": [
                "selections"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 10000
          },
          "directives": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "outputId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "state": {
                      "const": "unset"
                    }
                  },
                  "required": [
                    "outputId",
                    "state"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "outputId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "state": {
                      "const": "set"
                    },
                    "value": {
                      "oneOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "string",
                          "maxLength": 1024
                        }
                      ]
                    }
                  },
                  "required": [
                    "outputId",
                    "state",
                    "value"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "minItems": 0,
            "maxItems": 10000
          }
        },
        "required": [
          "id",
          "anyOf",
          "directives"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "conditions",
    "outputs",
    "rules"
  ],
  "additionalProperties": false
}
