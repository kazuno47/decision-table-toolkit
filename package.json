{
  "name": "decision-table-toolkit",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "build:offline": "node scripts/build.mjs --offline-compiler",
    "check:offline": "npm run typecheck && npm test && npm run build:offline"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "5.9.3"
  }
}
